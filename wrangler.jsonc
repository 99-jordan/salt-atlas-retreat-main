{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salt-atlas-retreat",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "triggers": {
    "crons": ["0 6 * * *", "*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "SCRAPE_BUCKET",
      "bucket_name": "salt-atlas-scrape"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salt-atlas-scrape",
      "database_id": "6f0007ea-1ac1-4ceb-ae3d-24b204fbca2a",
      "migrations_dir": "drizzle"
    }
  ]
}
