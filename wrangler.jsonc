{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salt-atlas-retreat",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  // Create with: bunx wrangler r2 bucket create salt-atlas-scrape
  "r2_buckets": [
    {
      "binding": "SCRAPE_BUCKET",
      "bucket_name": "salt-atlas-scrape"
    }
  ],
  // Create with: bunx wrangler d1 create salt-atlas-scrape
  // Then replace database_id with the id wrangler prints.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salt-atlas-scrape",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
